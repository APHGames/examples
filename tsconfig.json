{
	"compilerOptions": {
		"target": "ES2020",
		"skipLibCheck": true,
		"lib": [
			"ES2020",
			"DOM"
		],
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"outDir": "./build",
		"downlevelIteration": true,
		"strict": false,
		"baseUrl": ".",
		"paths": {
			"colfio": ["../src/index.ts"],
			"pixi.js": ["./node_modules/pixi.js"]
		}
	},
	"include": [
		"./src/**/*.ts",
		"./libs/aph-math/**/*.ts",
		"./libs/network-emulator/**/*.ts",
		"./libs/pixi-matter/**/*.ts"
	],
	"exclude": [
		"./node_modules",
		"./scripts"
	]
}
